{
  "name": "@ventneuf/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ventneuf-runner": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "install-service": "npm run build && node dist/index.js install",
    "status-service": "node dist/index.js status",
    "uninstall-service": "node dist/index.js uninstall",
    "start": "node dist/index.js",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
